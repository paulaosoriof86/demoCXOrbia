    "VRM-107": {
      "id": "VRM-107",
      "classification": "FUNCTIONAL_DEFECT",
      "severity": "P0",
      "title": "Fresh HR polling could enqueue duplicate durable reconciliation for the same revision and starve visit reconciliation before provider ACK",
      "state": "FIXED_PROVEN_RUN736",
      "exactOwners": [
        "backend/runtime/hr-live-service/server.mjs",
        "tools/qa/cxorbia-prei4-content001-dev-materialize.sh"
      ],
      "rootCause": [
        "server.mjs scheduled shopper+visit reconciliation after every fresh read without an in-flight single-flight guard keyed by source revision",
        "the canonical DEV materializer polled the HR meta endpoint every 5 seconds while cacheMs=5000, causing additional source refreshes and duplicate same-revision reconciliation while the first 222-shopper reconciliation was still running",
        "Run735 proved the effect: shopper reconciliation completed repeatedly while visitReconciliation remained null until the gate timed out"
      ],
      "remediationContract": "One durable reconciliation chain per sourceRevision. Fresh HR remains published immediately, but repeated reads of the same revision reuse the in-flight reconciliation. CI waits for provider ACK through the Cloud Run health endpoint without triggering more HR refreshes, then validates one post-ACK HR meta read.",
