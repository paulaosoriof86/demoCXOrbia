+      fields.some(k=>raw[k]!=null&&(typeof raw[k]!=='string'||raw[k].length>240||/[\u0000-\u001f<>]/.test(raw[k])));
+    if (badShape||!row.sucursal||!allowedDate(period,row.fecha)) {
