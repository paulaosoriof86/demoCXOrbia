rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function isSuper() {
      return role() == 'super';
    }

    function isAdmin() {
      return role() in ['super', 'admin'];
    }

    function isOps() {
      return role() == 'ops';
    }

    function isCoordinator() {
      return role() == 'coordinador';
    }

    function isOperator() {
      return role() in ['super', 'admin', 'ops', 'coordinador'];
    }


    // C04 Global read: same exact tenant membership used by the finance provider.
    function canReadGlobalFinance(tenantId) {
      let memberPath = /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
      let member = get(memberPath);
      return signedIn() &&
        request.auth.token.get('tenantId', '') == tenantId &&
        request.auth.token.get('authNamespace', 'staff') == 'staff' &&
        isAdmin() &&
        exists(memberPath) &&
        member.data.get('active', false) == true &&
        member.data.get('tenantId', '') == tenantId &&
        member.data.get('role', '') == role() &&
        member.data.get('authNamespace', '') == 'staff' &&
        (isSuper() || member.data.get('entitlementMode', '') == 'TYA_COMPLETE');
    }

    function financeGlobalGetGuard(tenantId) {
      return resource.data.get('global', false) != true || canReadGlobalFinance(tenantId);
    }

    // Queries must prove a project scope. A missing marker is safe for an exact
    // legacy get, but must never authorize an unfiltered query that can include Global.
    // Provider-owned Global rows have projectId null; client writes remain denied.
    function financeGlobalListGuard(tenantId) {
      return (resource.data.projectId is string && resource.data.projectId != '') ||
        canReadGlobalFinance(tenantId);
    }

    function financeGlobalAuditListGuard(tenantId) {
      return (resource.data.projectId is string && resource.data.projectId != '') ||
        (resource.data.entityType is string &&
          !(resource.data.entityType in ['financialMovement', 'financeAccount'])) ||
        canReadGlobalFinance(tenantId);
    }

    // User creation and scope grants already belong to the Super user-admin
    // provider. Ordinary Admin profile edits cannot change its authority fields.
    function membershipAuthorityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'entitlementMode', 'active', 'tenantId', 'role', 'authNamespace',
        'projectIds', 'countries'
      ]);
    }

    function isClient() {
      return role() in ['cliente', 'client'];
    }

    function isShopperRole() {
      return role() == 'shopper';
    }

    function tenantAllowed(tenantId) {
      return signedIn() && (
        isSuper() ||
        request.auth.token.tenantId == tenantId ||
        (request.auth.token.tenants is list && tenantId in request.auth.token.tenants)
      );
    }

    function projectAssigned(projectId) {
      return request.auth.token.projectIds is list && projectId in request.auth.token.projectIds;
    }

    function canAccessProject(projectId) {
      return isOperator() || projectAssigned(projectId);
    }

    function canReadProject(projectId) {
      return isOperator() || isClient() && projectAssigned(projectId) || isShopperRole() && projectAssigned(projectId);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shopperId() {
      return signedIn() && request.auth.token.shopperId is string
        ? request.auth.token.shopperId
        : '';
    }

    function country() {
      return signedIn() && request.auth.token.country is string
        ? request.auth.token.country
        : '';
    }

    function isOwnShopper(shopperIdParam) {
      return isShopperRole() && shopperId() == shopperIdParam;
    }

    function isOwnResource() {
      return isShopperRole() && resource.data.shopperId == shopperId();
    }

    function isOwnIncomingResource() {
      return isShopperRole() && request.resource.data.shopperId == shopperId();
    }

    function canWriteBulletins() {
      return role() in ['super', 'admin', 'ops', 'coordinador'];
    }

    function operationDocForTenant(tenantId) {
      return tenantAllowed(tenantId) &&
        isOperator() &&
        request.resource.data.tenantId == tenantId;
    }

    function listHasValue(fieldName, value) {
      return resource.data[fieldName] is list && value != '' && value in resource.data[fieldName];
    }

    // A bulletin explicitly addressed to one or more principals cannot be
    // converted into a project/role-wide announcement by its display metadata.
    function bulletinHasExactRecipients() {
      return (resource.data.get('targetShopperIds', []) is list &&
              resource.data.get('targetShopperIds', []).size() > 0) ||
             (resource.data.get('targetUserIds', []) is list &&
              resource.data.get('targetUserIds', []).size() > 0);
    }

    function bulletinTargetsCurrentUser(tenantId) {
      return tenantAllowed(tenantId) && (
        (isShopperRole() && shopperId() != '' &&
         resource.data.get('targetShopperIds', []).hasAny([shopperId()])) ||
        resource.data.get('targetUserIds', []).hasAny([request.auth.uid]) ||
        resource.data.get('supportRequesterUserId', '') == request.auth.uid ||
        (shopperId() != '' && resource.data.get('supportRequesterShopperId', '') == shopperId()) ||
        (!bulletinHasExactRecipients() && (
          resource.data.get('targetAll', false) == true ||
          listHasValue('targetTenants', tenantId) ||
          listHasValue('targetRoles', role()) ||
          (resource.data.get('targetProjectIds', []) is list &&
           request.auth.token.projectIds is list &&
           resource.data.get('targetProjectIds', []).hasAny(request.auth.token.projectIds)) ||
          listHasValue('targetCountries', country())
        ))
      );
    }

        function isAvailableVisitForShopper(projectId) {
      return isShopperRole() && projectAssigned(projectId) && (
        (resource.data.status is string && resource.data.status == 'disponible') ||
        (resource.data.estado is string && resource.data.estado == 'disponible')
      );
    }

    // Deny by default. Every collection below must prove tenant, project and role.
    match /{document=**} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      allow read: if tenantAllowed(tenantId) && (isOperator() || isClient() || isShopperRole());
      allow create, update: if tenantAllowed(tenantId) && isAdmin();
      allow delete: if tenantAllowed(tenantId) && isSuper();

      match /users/{uid} {
        allow read: if tenantAllowed(tenantId) && (isSelf(uid) || isAdmin());
        allow create, delete: if tenantAllowed(tenantId) && isSuper();
        allow update: if tenantAllowed(tenantId) &&
          (isSuper() || (isAdmin() && membershipAuthorityUnchanged()));
      }

      match /clients/{clientId} {
        allow read: if tenantAllowed(tenantId) && (isOperator() || isClient());
        allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();
      }

      match /shoppers/{shopperIdParam} {
        allow read: if tenantAllowed(tenantId) && (isOperator() || isOwnShopper(shopperIdParam));
        allow create: if tenantAllowed(tenantId) && isOperator();
        allow update: if tenantAllowed(tenantId) && (isOperator() || isOwnShopper(shopperIdParam));
        allow delete: if tenantAllowed(tenantId) && isAdmin();
      }

      match /shopperStats/{shopperIdParam} {
        allow read: if tenantAllowed(tenantId) && (isOperator() || isOwnShopper(shopperIdParam));
        allow create, update: if tenantAllowed(tenantId) && isOperator();
        allow delete: if tenantAllowed(tenantId) && isAdmin();
      }

      // Exact provider-backed identity crosswalks are readable only by authenticated
      // tenant operators. Browser writes stay denied; provider materialization continues
      // exclusively through gated server/Admin SDK executors.
      match /shopperIdentityLinks/{identityLinkId} {
        allow read: if tenantAllowed(tenantId) && isOperator();
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if tenantAllowed(tenantId) && (
          isOperator() ||
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.toRole == role()
        );
        allow create, update, delete: if tenantAllowed(tenantId) && isOperator();
      }

      match /bulletins/{bulletinId} {
        allow read: if tenantAllowed(tenantId) && (
          canWriteBulletins() ||
          bulletinTargetsCurrentUser(tenantId)
        );
        allow create, update: if tenantAllowed(tenantId) && canWriteBulletins() && request.resource.data.tenantId == tenantId;
        allow delete: if tenantAllowed(tenantId) && isAdmin();
      }

      match /bulletinReads/{readId} {
        allow read: if tenantAllowed(tenantId) && (
          canWriteBulletins() ||
          resource.data.userId == request.auth.uid
        );
        allow create, update: if tenantAllowed(tenantId) &&
          request.resource.data.tenantId == tenantId &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

      match /automations/{automationId} {
        allow read: if tenantAllowed(tenantId) && isAdmin();
        allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();
      }

      match /integrationSettings/{settingId} {
        allow read: if tenantAllowed(tenantId) && isAdmin();
        allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();
      }

      match /automationLogs/{logId} {
        allow read: if tenantAllowed(tenantId) && isAdmin();
        allow create: if tenantAllowed(tenantId) && isOperator();
        allow update, delete: if false;
      }

      match /aiSettings/{settingId} {
        allow read: if tenantAllowed(tenantId) && isAdmin();
        allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();
      }

      match /aiLogs/{logId} {
        allow read: if tenantAllowed(tenantId) && isAdmin();
        allow create: if tenantAllowed(tenantId) && isOperator();
        allow update, delete: if false;
      }

      match /resources/{resourceId} {
        function certificationBank(data) {
          return data.get('resourceType', '') == 'certification_bank' || data.get('tipo', '') == 'certification_bank';
        }
        function certificationWriter(data) {
          let memberPath = /databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid);
          let member = get(memberPath).data;
          return request.auth.token.role in ['super', 'admin'] && request.auth.token.get('tenantId', '') == tenantId &&
            exists(memberPath) && member.get('active', true) != false && member.get('status', 'active').lower() != 'inactive' &&
            member.get('role', '') == request.auth.token.role && member.get('authNamespace', '') == 'staff' && request.auth.token.get('authNamespace', '') == 'staff' &&
            member.get('tenantId', tenantId) == tenantId &&
            (request.auth.token.role == 'super' || member.get('projectIds', []) is list && data.projectId in member.get('projectIds', [])) &&
            exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(data.projectId));
        }
        function validCertificationPolicy(data) {
          let a = data.get('certificationReviewPolicy', 'authorized_admin');
          let b = data.get('certReviewPolicy', 'authorized_admin');
          let values = ['authorized_admin', 'maker_checker', 'distinct_reviewer', 'two_person'];
          return a is string && b is string && a.trim().lower() in values && b.trim().lower() in values &&
            (!('certificationReviewPolicy' in data) || !('certReviewPolicy' in data) ||
             (a.trim().lower() == 'authorized_admin') == (b.trim().lower() == 'authorized_admin'));
        }
        function configuredCertificationPolicy(data) {
          return 'certificationReviewPolicy' in data || 'certReviewPolicy' in data;
        }
        function distinctCertificationPolicy(data) {
          return data.get('certificationReviewPolicy', data.get('certReviewPolicy', 'authorized_admin')).trim().lower() != 'authorized_admin';
        }
        function certificationPeriodAlias(data) {
          let period = data.periodId;
          let project = data.projectId;
          let month = '[0-9]{4}-(0[1-9]|1[0-2])';
          return period.matches('^' + month + '$') ? project + '-' + period :
            (project.matches('^[a-zA-Z0-9_-]+$') && period.matches('^' + project + '-' + month + '$') ? period.replace('^' + project + '-', '') : period);
        }
        function certificationReviewAuthorized(data) {
          let projectPath = /databases/$(database)/documents/tenants/$(tenantId)/projects/$(data.projectId);
          let exactPath = /databases/$(database)/documents/tenants/$(tenantId)/projects/$(data.projectId)/periods/$(data.periodId);
          let alias = certificationPeriodAlias(data);
          let aliasPath = /databases/$(database)/documents/tenants/$(tenantId)/projects/$(data.projectId)/periods/$(alias);
          let exactExists = exists(exactPath);
          let aliasExists = alias != data.periodId && exists(aliasPath);
          let project = get(projectPath).data;
          let period = exactExists ? get(exactPath).data : (aliasExists ? get(aliasPath).data : {});
          let effective = configuredCertificationPolicy(period) ? period : project;
          return !(exactExists && aliasExists) && validCertificationPolicy(project) && validCertificationPolicy(period) &&
            project.get('tenantId', tenantId) == tenantId && project.get('projectId', data.projectId) == data.projectId &&
            period.get('tenantId', tenantId) == tenantId && period.get('projectId', data.projectId) == data.projectId &&
            period.get('periodId', data.periodId) in [data.periodId, alias] && period.get('id', data.periodId) in [data.periodId, alias] &&
            (!distinctCertificationPolicy(effective) || data.bank.generadoPorUid != request.auth.uid);
        }
        function validCertificationDraft(data) {
          return data.get('id', resourceId) == resourceId && data.get('tenantId', tenantId) == tenantId &&
            data.resourceType == 'certification_bank' && data.tipo == 'certification_bank' &&
            data.projectId is string && data.projectId.size() > 0 && data.periodId is string && data.periodId.size() > 0 &&
            data.status == 'active' && data.bank is map && data.bank.estado == 'pending_review' &&
            data.bank.generadoPorUid is string && data.bank.generadoPorUid.size() > 0 &&
            data.bank.contentRevision is string && data.bank.contentRevision.size() > 0 &&
            data.bank.preguntas is list && data.bank.preguntas.size() > 0 && data.version is int && data.version > 0;
        }
        function createCertificationDraft(data) {
          return validCertificationDraft(data) && certificationWriter(data) && data.version == 1 &&
            data.createdByUid == request.auth.uid && data.updatedByUid == request.auth.uid &&
            data.bank.generadoPorUid == request.auth.uid && data.bank.get('reviewHistory', []) == [] &&
            !data.bank.keys().hasAny(['publicationAuthority', 'publishedAt', 'revisadoPorUid', 'revisadoPor', 'ultimaRevisionPorUid']);
        }
        function updateCertificationDraft(before, after) {
          let history = before.bank.get('reviewHistory', []);
          let nextHistory = after.bank.get('reviewHistory', []);
          let last = nextHistory[nextHistory.size() - 1];
          return before.resourceType == 'certification_bank' && before.tipo == 'certification_bank' && before.status == 'active' && before.bank.estado == 'pending_review' &&
            validCertificationDraft(after) && certificationWriter(after) &&
            certificationReviewAuthorized(before) && after.id == resourceId && after.tenantId == tenantId &&
            after.projectId == before.projectId && after.periodId == before.periodId && after.version == before.version + 1 &&
            after.createdAt == before.createdAt && after.createdByUid == before.createdByUid && after.updatedByUid == request.auth.uid &&
            after.diff(before).affectedKeys().hasOnly(['id', 'tenantId', 'n', 'bank', 'version', 'updatedAt', 'updatedByUid', 'lastIdempotencyKey']) &&
            after.bank.diff(before.bank).affectedKeys().hasOnly(['certificationName', 'preguntas', 'contentRevision', 'previousContentRevision', 'reviewHistory', 'reviewVersion', 'ultimaRevisionPorUid', 'ultimaRevisionAt']) &&
            after.bank.preguntas.size() == before.bank.preguntas.size() && after.bank.generadoPorUid == before.bank.generadoPorUid &&
            after.bank.contentRevision != before.bank.contentRevision && after.bank.previousContentRevision == before.bank.contentRevision &&
            after.bank.ultimaRevisionPorUid == request.auth.uid && after.bank.reviewVersion == after.version &&
            history is list && nextHistory is list && history.size() < 25 && nextHistory.size() == history.size() + 1 &&
            nextHistory == history.concat([last]) && last.reviewerUid == request.auth.uid &&
            last.fromVersion == before.version && last.toVersion == after.version &&
            last.previousContentRevision == before.bank.contentRevision && last.contentRevision == after.bank.contentRevision;
        }
        allow read: if tenantAllowed(tenantId) && (
          isOperator() ||
          isShopperRole() &&
          resource.data.status == 'active' &&
          resource.data.projectId in request.auth.token.projectIds &&
          role() in resource.data.visibleRoles
        );
        allow create: if tenantAllowed(tenantId) && isOperator() &&
          (!certificationBank(request.resource.data) || createCertificationDraft(request.resource.data));
        allow update: if tenantAllowed(tenantId) && isOperator() &&
          ((!certificationBank(resource.data) && !certificationBank(request.resource.data)) ||
           (certificationBank(resource.data) && certificationBank(request.resource.data) && updateCertificationDraft(resource.data, request.resource.data)));
        // Publication/configuration/retirement are validated in the existing runtime.
        // Physical deletion of a bank is forbidden; attempts keep their exact source link.
        allow delete: if tenantAllowed(tenantId) && isOperator() && !certificationBank(resource.data);
      }

      match /auditLogs/{logId} {
        allow read: if tenantAllowed(tenantId) && isAdmin();
        allow create: if tenantAllowed(tenantId) && signedIn();
        allow update, delete: if false;
      }

      match /operationActions/{actionId} {
        allow read: if tenantAllowed(tenantId) && isOperator();
        allow create: if operationDocForTenant(tenantId);
        allow update, delete: if false;
      }

      match /operationEvents/{eventId} {
        allow read: if tenantAllowed(tenantId) && isOperator();
        allow create: if operationDocForTenant(tenantId);
        allow update, delete: if false;
      }

      match /entityAuditTrail/{auditId} {
        allow get: if tenantAllowed(tenantId) && isOperator() && financeGlobalGetGuard(tenantId);
        allow list: if tenantAllowed(tenantId) && isOperator() && financeGlobalAuditListGuard(tenantId);
        allow create: if operationDocForTenant(tenantId) &&
          request.resource.data.get('global', false) != true;
        allow update, delete: if false;
      }

      match /operationActionLocks/{lockId} {
        allow read: if tenantAllowed(tenantId) && isOperator();
        allow create: if operationDocForTenant(tenantId);
        allow update, delete: if false;
      }

      match /shopperBenefits/{benefitId} {
        allow read: if tenantAllowed(tenantId) && (
          isAdmin() ||
          isOps() ||
          isOwnResource()
        );
        allow create, update: if tenantAllowed(tenantId) && isAdmin();
        allow delete: if tenantAllowed(tenantId) && isAdmin();
      }

      // PRE-I4 VRM-142: finance writes remain provider-only. Authenticated
      // operators may read the durable projections required by Finanzas/Liquidaciones.
      match /financialMovements/{movementId} {
        allow get: if tenantAllowed(tenantId) && isOperator() && financeGlobalGetGuard(tenantId);
        allow list: if tenantAllowed(tenantId) && isOperator() && financeGlobalListGuard(tenantId);
        allow create, update, delete: if false;
      }

      // I3 HF26: budget is a provider-owned plan, not a movement or bank/payment event.
      match /financeBudgets/{budgetId} {
        allow read: if tenantAllowed(tenantId) && isOperator();
        allow create, update, delete: if false;
      }

      match /financeAccounts/{accountId} {
        allow get: if tenantAllowed(tenantId) && isOperator() && financeGlobalGetGuard(tenantId);
        allow list: if tenantAllowed(tenantId) && isOperator() && financeGlobalListGuard(tenantId);
        allow create, update, delete: if false;
      }

      match /projects/{projectId} {
        allow read: if tenantAllowed(tenantId) && canReadProject(projectId);
        allow list: if tenantAllowed(tenantId) && isOperator();
        allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();

        match /periods/{periodId} {
          allow read: if tenantAllowed(tenantId) && canReadProject(projectId);
          allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();
        }

        match /hrImports/{importId} {
          allow read: if tenantAllowed(tenantId) && isOperator();
          allow create, update, delete: if tenantAllowed(tenantId) && isAdmin();
        }

        match /branches/{branchId} {
          allow read: if tenantAllowed(tenantId) && canReadProject(projectId);
          allow create, update, delete: if tenantAllowed(tenantId) && isOperator();
        }

        // I3 Work UAT: read persisted reservations in the exact project and
        // shopper scope. Provider-only writes remain blocked in browser.
        match /reservations/{reservationId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            (isShopperRole() && projectAssigned(projectId) &&
             shopperId() != '' && isOwnResource())
          );
          allow create, update, delete: if false;
        }

        match /visits/{visitId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            isClient() && projectAssigned(projectId) ||
            isOwnResource() ||
            isAvailableVisitForShopper(projectId)
          );
          allow create, delete: if tenantAllowed(tenantId) && isOperator();
          allow update: if tenantAllowed(tenantId) && (
            isOperator() ||
            isOwnResource()
          );
        }

        match /applications/{applicationId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            isOwnResource()
          );
          allow create: if tenantAllowed(tenantId) && (
            isOperator() ||
            isOwnIncomingResource()
          );
          allow update, delete: if tenantAllowed(tenantId) && isOperator();
        }

        match /postulations/{postulationId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            isOwnResource()
          );
          allow create: if tenantAllowed(tenantId) && (
            isOperator() ||
            isOwnIncomingResource()
          );
          allow update, delete: if tenantAllowed(tenantId) && isOperator();
        }

        match /notifications/{notificationId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            resource.data.uid == request.auth.uid ||
            resource.data.userId == request.auth.uid ||
            resource.data.toRole == role()
          );
          allow create, update, delete: if tenantAllowed(tenantId) && isOperator();
        }

        match /certifications/{certificationId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            isShopperRole() && projectAssigned(projectId) && resource.data.shopperId == shopperId()
          );
          allow create, update, delete: if false;
        }

        match /certificationRecertifications/{requestId} {
          allow read: if tenantAllowed(tenantId) && (
            isOperator() ||
            isShopperRole() && projectAssigned(projectId) &&
            resource.data.status == 'active' &&
            (
              resource.data.scope == 'all' ||
              (resource.data.targetShopperIds is list && shopperId() in resource.data.targetShopperIds)
            )
          );
          allow create, update, delete: if false;
        }
      }
    }
  }
}
