  "findings": [
    {
      "id": "F8-EXECUTOR-MECH-005",
      "classification": "PRE_EXECUTION_MECHANISM_DEFECT",
      "detail": "The temporary restore database identifier was assigned before BACKUP_EXPORT. The finally block treated any non-null tempDb as cleanup-eligible, so an export failure before database creation could still issue an unnecessary DELETE mutation against a database name that this execution had never created."
    },
    {
      "id": "F8-EXECUTOR-MECH-006",
      "classification": "PRE_EXECUTION_MECHANISM_HARDENING_GAP",
      "detail": "The temporary database identifier used only minute-level timestamp precision. Independent workspaces starting within the same minute could target the same temporary database identifier despite the local checkout lease."
    },
    {
      "id": "F8-EXECUTOR-MECH-007",
      "classification": "PRE_EXECUTION_MECHANISM_DEFECT",
      "detail": "A failed or uncertain normal temporary-database DELETE could fall through to finally while tempDb remained set and automatically emit another DELETE request, conflicting with the no-automatic-retry execution contract."
    }
  ],
