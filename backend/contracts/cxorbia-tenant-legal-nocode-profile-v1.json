{
  "schemaVersion": "cxorbia.tenant-legal-nocode-profile.v1",
  "status": "source_only_contract_prepared_no_provider_materialization",
  "purpose": "Reusable provider-authoritative no-code legal/compliance configuration for every CXOrbia successor-brand tenant without hardcoded client, country, project, brand or integration values.",
  "invariants": {
    "tenantSpecificValuesInRuntimeCode": false,
    "projectSpecificEvidenceRulesInRuntimeCode": false,
    "brandNameHardcodedIntoLegalRuntime": false,
    "providerRegistryHardcodedIntoLegalText": false,
    "legalProfileProviderAuthoritative": true,
    "adminEditableThroughAuthorizedProductUI": true,
    "historicalPublishedLegalVersionsImmutable": true,
    "legalRelevantChangeRequiresVersionImpactEvaluation": true,
    "automaticHumanAcceptance": false,
    "projectEvidenceConfigurationAtProjectCreateOrEdit": true,
    "crossTenantReuse": true
  },
  "scope": {
    "tenantId": "required_from_authenticated_context",
    "projectId": "optional_for_tenant_profile_required_for_project_evidence_policy",
    "countryCode": "configured_not_hardcoded",
    "platformBrand": "configured_not_hardcoded"
  },
  "tenantLegalProfile": {
    "providerPathTemplate": "tenants/{tenantId}/legalProfile/current",
    "editableFields": [
      "operator.legalDisplayName",
      "operator.ownerOrContractingPersonName",
      "operator.entityType",
      "operator.taxId",
      "operator.registrationReferences",
      "operator.countryOfEstablishment",
      "operator.operatingCountries",
      "operator.franchiseModel",
      "operator.legalDomicile",
      "contacts.legal",
      "contacts.privacy",
      "contacts.securityIncidents",
      "disputePolicy",
      "retentionPolicy",
      "sensitiveDataPolicy",
      "platformBrandProfile",
      "platformLicensorProfile",
      "providerLegalMetadata"
    ],
    "systemDerivedFields": [
      "tenantId",
      "updatedAt",
      "updatedByUid",
      "revision",
      "activeProviderTechnicalState"
    ],
    "writeRule": "future_explicit_gate_required",
    "auditRule": "append_revision_audit_never_silent_overwrite"
  },
  "platformBrandProfile": {
    "displayName": "editable_no_code",
    "legalGenericReference": "La Plataforma",
    "rebrandSafe": true,
    "registeredTrademarkClaim": "forbidden_unless_registration_status_and_reference_are_verified",
    "registrationStatus": ["unregistered", "application_pending", "registered", "not_applicable"],
    "registrationReference": "optional_only_when_verified",
    "legalCopyRule": "prefer_generic_platform_reference_and_resolve_display_name_from_provider_profile"
  },
  "platformLicensorProfile": {
    "licensorName": "editable_no_code_but_change_requires_legal_review",
    "licensorType": ["individual", "legal_entity", "contractual_owner_or_licensee"],
    "rightsBasis": ["creator_owner", "assignment", "license", "other_documented_basis"],
    "rightsInstrumentReference": "optional_but_required_before_claiming_assignment_or_entity_ownership",
    "brandOwnershipIsNotSoftwareOwnership": true,
    "configurationChangeDoesNotTransferIntellectualProperty": true
  },
  "providerRegistry": {
    "providerPathTemplate": "tenants/{tenantId}/legalProviders/{providerKey}",
    "technicalActiveState": "system_derived_from_actual_enabled_runtime_integration_or_core_infrastructure",
    "adminEditableLegalMetadata": [
      "displayName",
      "purpose",
      "dataCategories",
      "processingLocations",
      "privacyReference",
      "contractReference",
      "notes"
    ],
    "disabledProviderMayBeDescribedAsCurrentRecipient": false,
    "activationRequiresLegalImpactCheck": true,
    "materialProviderChangeMayRequireNewPrivacyNoticeVersion": true,
    "makeOrGeminiActivationByDocumentationAlone": false
  },
  "retentionPolicy": {
    "tenantDefaultsEditableNoCode": true,
    "projectOverrideAllowed": true,
    "legalHoldOverridesDeletion": true,
    "minimumRawEvidenceDaysConfigurable": true,
    "recommendedDefaults": {
      "rawFieldEvidenceDaysAfterFinalAcceptance": 90,
      "rawFieldEvidenceMinimumFloorDays": 60,
      "preciseGeolocationDaysAfterFinalAcceptance": 90,
      "bankAccountFullDataDaysAfterFinalPaymentOrDeactivation": 180,
      "commercialOperationalAuditYears": 5,
      "financialLiquidationPaymentLedgerYears": 5,
      "legalAcceptanceReceiptYearsAfterRelationshipEnd": 5
    },
    "bankAccountPostRetention": "after_full_data_expiry_retain_only_masked_or_fingerprinted_audit_reference_when_needed",
    "rawEvidenceRule": "project_may_extend_or_reduce_subject_to_minimum_floor_client_contract_and_law",
    "destructionRule": "delete_anonymize_or_restrict_archive_after_applicable_period_unless_legal_hold"
  },
  "sensitiveDataPolicy": {
    "fullBankAccountAllowed": true,
    "fullBankAccountConditions": [
      "encrypted_at_rest_or_field_level_equivalent",
      "encrypted_in_transit",
      "role_restricted",
      "masked_by_default_in_ui",
      "never_in_repo",
      "never_in_logs",
      "never_in_ai_prompts",
      "never_in_unapproved_exports"
    ],
    "identityDocuments": "collect_only_fields_or_files_strictly_needed_by_configured_process",
    "documentMinimization": true,
    "rawSecretsInRepo": false
  },
  "projectEvidencePolicy": {
    "providerPathTemplate": "tenants/{tenantId}/projects/{projectId}/evidencePolicy/current",
    "requiredAtProjectCreationOrExplicitlyInherited": true,
    "editableNoCode": true,
    "fields": [
      "photo.required",
      "video.required",
      "audio.required",
      "geolocation.required",
      "receipt.required",
      "otherEvidenceTypes",
      "retentionOverrideDays",
      "captureInstructions",
      "legalBasisOrApprovalReference",
      "highImpactProcessingEnabled"
    ],
    "audioVideoGeolocationGlobalDefault": "not_assumed",
    "highImpactProcessingRule": "biometrics_face_recognition_or_other_high_impact_capture_requires_separate_legal_gate_before_enable"
  },
  "disputePolicy": {
    "editableNoCode": true,
    "recommendedTyAProfile": {
      "b2bClients": "negotiation_then_institutional_arbitration_when_contractually_valid",
      "individualUsers": "good_faith_resolution_then_applicable_courts_unless_local_counsel_confirms_valid_specific_arbitration_clause",
      "nonArbitrableMatters": "competent_courts",
      "defaultArbitrationSeat": "configured_per_tenant_or_contract_not_hardcoded"
    },
    "countryAnnexRequired": true
  },
  "legalVersioning": {
    "publishedLegalContentSeparateFromMutableProfile": true,
    "profileChangeDoesNotRewritePublishedContent": true,
    "legalImpactEvaluationOnChange": [
      "operator_identity",
      "contracting_person_or_entity",
      "country_scope",
      "privacy_contact",
      "material_retention_change",
      "provider_activation_with_new_data_flow",
      "dispute_policy",
      "platform_licensor",
      "evidence_processing_scope"
    ],
    "materialChangeAction": "prepare_new_immutable_legal_version_and_require_human_review_before_publish",
    "reacceptance": "only_when_policy_marks_change_material_and_provider_publishes_new_version"
  },
  "claudeFrontendContract": {
    "backendMustNotPatchUi": true,
    "requiredFutureProductSurfaces": [
      "Configuracion > Legal y cumplimiento > Perfil legal del tenant",
      "Configuracion > Marca > Nombre visible y estado de marca",
      "Configuracion > Legal y cumplimiento > Retencion",
      "Configuracion > Integraciones > Registro de proveedores y estado real",
      "Proyecto > Crear/Editar > Evidencias y privacidad",
      "Configuracion > Legal y cumplimiento > Resolucion de controversias"
    ],
    "allTenantValuesEditableWithoutCode": true,
    "projectEvidenceRulesEditableWithoutCode": true
  },
  "safetyForThisBlock": {
    "tenantProviderWrites": 0,
    "legalContentWrites": 0,
    "legalAcceptanceWrites": 0,
    "authWrites": 0,
    "firestoreWrites": 0,
    "hrWrites": 0,
    "storageWrites": 0,
    "rulesWrites": 0,
    "makeWrites": 0,
    "geminiCalls": 0,
    "deploys": 0,
    "merge": false,
    "production": false
  },
  "nextGate": "HUMAN_REVIEW_OF_TYA_LEGAL_DRAFT_AND_NOCODE_PROFILE_BEFORE_ANY_PROVIDER_MATERIALIZATION"
}
