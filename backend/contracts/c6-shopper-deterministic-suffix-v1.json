{
  "schemaVersion": "cxorbia.c6.shopper-deterministic-suffix.v2",
  "status": "tenant_authorized_readonly_planning_contract",
  "tenantId": "tya",
  "projectId": "cinepolis",
  "firebaseProjectId": "cxorbia-backend-dev",
  "visibleLoginPolicy": {
    "default": "nombre.apellido",
    "exception": "DETERMINISTIC_TECHNICAL_SUFFIX",
    "scope": "distinct_active_people_sharing_same_visible_login_only",
    "preserveUnsuffixedWhen": "one_unique_technical_holder_exists",
    "suffixDerivation": "sha256(tenantId + NUL + shopperId)",
    "suffixLengths": [
      4,
      6,
      8
    ],
    "suffixContainsPii": false,
    "separator": "."
  },
  "technicalSurnameCompletion": {
    "allowedSources": [
      "explicit profile surname",
      "explicit linked technical surname",
      "exact legacy credential login",
      "multi-source full-name consensus"
    ],
    "singlePositionOnlyInferenceAllowed": false,
    "conflictPolicy": "HOLD",
    "diagnosticContract": {
      "preConsensusIncompleteActiveProfiles": "active incomplete before consensus",
      "completedByConsensus": "completed only by multi-source consensus",
      "remainingIncompleteActiveProfiles": "active incomplete after all allowed methods",
      "metricIdentity": "preConsensusIncompleteActiveProfiles = completedByConsensus + remainingIncompleteActiveProfiles",
      "holdVector": {
        "first": [
          "complete",
          "candidateCount",
          "basisCount"
        ],
        "surname": [
          "complete",
          "explicitCandidateCount",
          "technicalLoginCandidateCount",
          "consensusCandidateCount",
          "basisCount",
          "conflict"
        ],
        "passwordSeed": [
          "complete",
          "candidateCount",
          "basisCount"
        ]
      },
      "rawValuesAllowed": false
    }
  },
  "multiAuthResolution": {
    "signals": [
      "exact custom claims",
      "shopperId claim",
      "exact target email",
      "exact credential email",
      "password compatibility",
      "enabled state",
      "provider metadata"
    ],
    "tiePolicy": "STOP_RETRY",
    "diagnosticVector": {
      "candidateOrdinalOnly": true,
      "fields": [
        "score",
        "exactClaims",
        "shopperIdClaim",
        "targetEmailMatch",
        "baseEmailMatch",
        "credentialEmailMatch",
        "passwordCompatible",
        "enabled",
        "emailVerified",
        "providerCreationMetadataPresent"
      ],
      "scoreMarginRequired": true,
      "uidAllowed": false,
      "emailAllowed": false,
      "rawPiiAllowed": false
    }
  },
  "plan": {
    "rows": 340,
    "onePrimaryOperationPerProfile": true,
    "operations": [
      "CREATE_AUTH",
      "UPDATE_AUTH",
      "NO_OP",
      "HOLD",
      "PRESERVE_NO_AUTH"
    ],
    "executable": false,
    "diagnosticContractVersion": "v2"
  },
  "privacy": {
    "rawNamesInRepositoryOrEvidence": false,
    "rawVisibleLoginsInEvidence": false,
    "rawEmailsInEvidence": false,
    "rawPasswordsInEvidence": false,
    "uidsInEvidence": false,
    "suffixIsSourceSafe": true
  },
  "safeState": {
    "providerReads": true,
    "providerWrites": false,
    "authWrites": false,
    "passwordChanges": false,
    "membershipWrites": false,
    "firestoreWrites": false,
    "rulesWrites": false,
    "storageWrites": false,
    "hrWrites": false,
    "deploy": false,
    "payments": false,
    "merge": false,
    "production": false
  },
  "collisionReconciliation": {
    "groupFingerprintNamespace": "shopper-visible-login-group-v1",
    "basis": "normalized visible base login",
    "policy": "fingerprint_set_membership_not_rigid_aggregate_equality",
    "outputs": [
      "added",
      "removed",
      "unchangedCount",
      "exactMatch"
    ],
    "rigidExpectedGroupCountAllowed": false
  }
}
