{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cxorbia://contracts/tya-dev-scenario-lab-evidence-schema-v1",
  "title": "CXOrbia TyA DEV Scenario Lab Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedAt",
    "runId",
    "sourceHeadSha",
    "environment",
    "decision",
    "stage",
    "profiles",
    "fingerprintBefore",
    "fingerprintAfter",
    "cleanup",
    "baselineRestoredAfterCleanup",
    "captures",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cxorbia.dev-scenario-lab.runner-evidence.v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 10
    },
    "runId": {
      "type": "string",
      "pattern": "^AUDIT-[A-Z0-9-]+$"
    },
    "sourceHeadSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "environment": {
      "const": "DEV"
    },
    "decision": {
      "enum": [
        "PASS_CORE_OPERATIONS_SHOPPER_SCENARIO_LAB",
        "FAIL_CORE_OPERATIONS_SHOPPER_SCENARIO_LAB_CLEANED",
        "P0_CORE_OPERATIONS_SHOPPER_SCENARIO_LAB_CLEANUP_FAILED"
      ]
    },
    "stage": {
      "enum": [
        "SCENARIO_READY",
        "SCENARIO_EXECUTED",
        "CROSS_MODULE_VERIFIED",
        "CLEANUP_VERIFIED"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["profile", "decision", "steps"],
        "properties": {
          "profile": {
            "enum": [
              "CORE_OPERATIONS_ADMIN",
              "SHOPPER_FULL_CYCLE",
              "CROSS_MODULE_CONSISTENCY",
              "RELOAD_NEW_TAB_STABILITY",
              "EXPORTS_AND_VISIBLE_EVIDENCE"
            ]
          },
          "decision": {
            "enum": ["PASS", "FAIL", "BLOCKED"]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "state",
                "status",
                "code",
                "module",
                "route",
                "action",
                "expected",
                "observed",
                "snapshot"
              ],
              "properties": {
                "state": {"type": "string", "minLength": 1},
                "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
                "code": {"type": "string", "minLength": 1},
                "module": {"type": "string", "minLength": 1},
                "route": {"type": "string", "minLength": 1},
                "action": {"type": "string", "minLength": 1},
                "expected": {"type": ["string", "number", "boolean", "object", "array", "null"]},
                "observed": {"type": ["string", "number", "boolean", "object", "array", "null"]},
                "snapshot": {"type": ["object", "array", "null"]}
              }
            }
          }
        }
      }
    },
    "fingerprintBefore": {
      "$ref": "#/$defs/fingerprint"
    },
    "fingerprintAfter": {
      "$ref": "#/$defs/fingerprint"
    },
    "cleanup": {
      "type": "object",
      "required": [
        "attempted",
        "createdAuditIds",
        "deletedAuditIds",
        "missingDeletes",
        "unexpectedDeletes",
        "orphans",
        "preexistingEntitiesMutated"
      ],
      "properties": {
        "attempted": {"type": "boolean"},
        "createdAuditIds": {"type": "array", "items": {"type": "string"}},
        "deletedAuditIds": {"type": "array", "items": {"type": "string"}},
        "missingDeletes": {"type": "array", "items": {"type": "string"}},
        "unexpectedDeletes": {"type": "array", "items": {"type": "string"}},
        "orphans": {"type": "array", "items": {"type": "string"}},
        "preexistingEntitiesMutated": {"type": "array", "items": {"type": "string"}}
      }
    },
    "baselineRestoredAfterCleanup": {
      "type": "boolean"
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "profile", "route", "viewport"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "profile": {"type": "string", "minLength": 1},
          "route": {"type": "string", "minLength": 1},
          "viewport": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"}
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "containsSecrets",
        "containsCredentials",
        "containsPii",
        "crossTenantWrites",
        "productionWrites",
        "deployCount",
        "automaticRetry"
      ],
      "properties": {
        "containsSecrets": {"const": false},
        "containsCredentials": {"const": false},
        "containsPii": {"const": false},
        "crossTenantWrites": {"const": false},
        "productionWrites": {"const": false},
        "deployCount": {"type": "integer", "minimum": 0, "maximum": 1},
        "automaticRetry": {"const": false}
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "periodId",
        "visitsCount",
        "shoppersCount",
        "applicationsCount",
        "assignmentsCount",
        "reservationsCount",
        "settlementsCount",
        "auditEntityIds",
        "duplicateVisitKeys",
        "duplicateShopperIds",
        "sourceRevision",
        "sha256"
      ],
      "properties": {
        "tenantId": {"type": ["string", "null"]},
        "projectId": {"type": ["string", "null"]},
        "periodId": {"type": ["string", "null"]},
        "visitsCount": {"type": "integer", "minimum": 0},
        "shoppersCount": {"type": "integer", "minimum": 0},
        "applicationsCount": {"type": "integer", "minimum": 0},
        "assignmentsCount": {"type": "integer", "minimum": 0},
        "reservationsCount": {"type": "integer", "minimum": 0},
        "settlementsCount": {"type": "integer", "minimum": 0},
        "auditEntityIds": {"type": "array", "items": {"type": "string"}},
        "duplicateVisitKeys": {"type": "integer", "minimum": 0},
        "duplicateShopperIds": {"type": "integer", "minimum": 0},
        "sourceRevision": {"type": ["string", "number", "null"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
