rules_version = '2';

/*
 * CXOrbia · Corte 4 · Firestore DEV READ-ONLY bootstrap rules
 * ----------------------------------------------------------
 * Candidate rules only. firebase.json does NOT point to this file yet.
 * No deployment or provider activation is authorized by this file.
 * Corte 4 permits authenticated operator reads for one tenant and denies
 * every create/update/delete operation. Shopper/client RBAC is Corte 6.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function isReadOnlyOperator() {
      return role() in ['super', 'admin', 'ops', 'coordinador'];
    }

    function tenantAllowed(tenantId) {
      return signedIn() && isReadOnlyOperator() && (
        role() == 'super' ||
        request.auth.token.tenantId == tenantId ||
        (request.auth.token.tenants is list && tenantId in request.auth.token.tenants)
      );
    }

    // Global fail-closed default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Corte 4 bootstrap: authenticated operator read only.
    match /tenants/{tenantId} {
      allow read: if tenantAllowed(tenantId);
      allow create, update, delete: if false;

      match /{document=**} {
        allow read: if tenantAllowed(tenantId);
        allow create, update, delete: if false;
      }
    }
  }
}
